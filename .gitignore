# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
tmp
out-tsc

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

.nx/cache
.nx/workspace-data
.claude/worktrees
.claude/settings.local.json

vite.config.*.timestamp*
vitest.config.*.timestamp*

# Playwright
test-results/
playwright-report/
.vercel
.env*.local

# apps/api ingestion snapshot (regenerated by crawling TVMaze on boot)
apps/api/data/

# apps/api/.env holds ADMIN_TOKEN — a secret in real deployments even
# though it defaults to a placeholder. Copy apps/api/.env.example locally.
apps/api/.env
