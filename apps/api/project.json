{
  "name": "api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/api/src",
  "projectType": "application",
  "tags": ["scope:api", "type:app"],
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx watch --tsconfig apps/api/tsconfig.json apps/api/src/main.ts"
      }
    },
    "start": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx --tsconfig apps/api/tsconfig.json apps/api/src/main.ts"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p apps/api/tsconfig.json"
      }
    }
  }
}
